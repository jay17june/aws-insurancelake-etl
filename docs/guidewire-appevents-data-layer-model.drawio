          <mxGeometry x="36" y="36" width="48" height="48" as="geometry" />
        </mxCell>

        <!-- Data Processing Details -->
        <mxCell id="processing-details" value="&lt;b&gt;Partition Append Behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;Standard InsuranceLake: clear_partition() overwrites&lt;br&gt;Guidewire AppEvents: partition_append=true skips clear&lt;br&gt;&lt;br&gt;Result: Multiple parquet files accumulate per partition:&lt;br&gt;year=2026/month=04/day=07/&lt;br&gt;├── part-00000-batch1.parquet (9:11 batch)&lt;br&gt;├── part-00000-batch2.parquet (9:26 batch)&lt;br&gt;├── part-00000-batch3.parquet (9:41 batch)&lt;br&gt;└── ...96 files by end of day..." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8C4FFF;fillColor=#F4F0FF;fontFamily=Helvetica;fontSize=10;fontColor=#16191F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="aws-cloud">
          <mxGeometry x="60" y="440" width="340" height="240" as="geometry" />
        </mxCell>

        <!-- Deduplication SQL Example -->
        <mxCell id="dedup-sql" value="&lt;b&gt;Current-State Deduplication SQL&lt;/b&gt;&lt;br&gt;&lt;br&gt;SELECT ... FROM (&lt;br&gt;  SELECT *, ROW_NUMBER() OVER (&lt;br&gt;    PARTITION BY claimnumber&lt;br&gt;    ORDER BY execution_id DESC&lt;br&gt;  ) as rn&lt;br&gt;  FROM gwclaimcenter.claims&lt;br&gt;) WHERE rn = 1&lt;br&gt;&lt;br&gt;Reads ALL cleanse data, keeps latest per claim" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3334B9;fillColor=#EBF3FF;fontFamily=Helvetica;fontSize=10;fontColor=#16191F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="aws-cloud">
          <mxGeometry x="780" y="440" width="280" height="240" as="geometry" />
        </mxCell>

        <!-- Stakeholder Benefits -->
        <mxCell id="stakeholder-benefits" value="&lt;b&gt;Stakeholder Benefits&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Claims Adjusters:&lt;/b&gt; Current state tables (Consume)&lt;br&gt;&lt;b&gt;Actuaries:&lt;/b&gt; Full event history (Cleanse)&lt;br&gt;&lt;b&gt;Regulators:&lt;/b&gt; Complete audit trail (Cleanse)&lt;br&gt;&lt;b&gt;Finance:&lt;/b&gt; Claims + Payments joins (Consume)&lt;br&gt;&lt;b&gt;Executives:&lt;/b&gt; Trend analysis (Consume)&lt;br&gt;&lt;b&gt;Data Engineers:&lt;/b&gt; Raw payloads (Collect)" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#F58536;fillColor=#FFF4E6;fontFamily=Helvetica;fontSize=10;fontColor=#16191F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="aws-cloud">
