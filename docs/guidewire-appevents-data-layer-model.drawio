        <!-- Tables in Consume -->
        <mxCell id="consume-tables" value="gwclaimcenter_consume.claims (10 unique)&lt;br&gt;gwclaimcenter_consume.exposures (13 unique)&lt;br&gt;gwclaimcenter_consume.payments (3 unique)&lt;br&gt;&lt;br&gt;&lt;b&gt;ROW_NUMBER() OVER (...)&lt;/b&gt;&lt;br&gt;Latest event per entity wins&lt;br&gt;Rebuilt from ALL cleanse data" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#3334B9;fillColor=#EBF3FF;fontFamily=Helvetica;fontSize=10;fontColor=#16191F;align=left;verticalAlign=top;spacingLeft=10;spacingTop=5;" vertex="1" parent="aws-cloud">
