        <!-- Right Sidebar Legend -->
        <mxCell id="legend-panel" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=light-dark(#EDF3FF,#305363);fillStyle=auto;container=1;pointerEvents=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="160" width="650" height="500" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="Process Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=light-dark(#000000,#FFFFFF);" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="20" width="200" height="30" as="geometry" />
