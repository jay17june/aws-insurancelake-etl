          <mxGeometry x="210" y="100" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="aws-cloud">
          <mxGeometry x="390" y="100" width="28" height="28" as="geometry" />
        </mxCell>
        <mxCell id="step4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="aws-cloud">
          <mxGeometry x="570" y="100" width="28" height="28" as="geometry" />
