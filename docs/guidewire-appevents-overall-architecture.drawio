        <mxCell id="legend-step1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="70" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step1-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Guidewire ClaimCenter writes AppEvents (ClaimCreated, ExposureAdded, PaymentCreated) to S3 bucket&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="70" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="118" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step2-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;S3 OBJECT_CREATED event notification sends message to SQS queue (with DLQ for failed messages)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="118" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="166" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step3-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;SQS Event Source Mapping auto-scales Lambda (up to 10 concurrent instances) based on queue depth&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="166" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="214" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step4-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Lambda classifies events by type and writes consolidated JSONL batches to InsuranceLake collect bucket&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="214" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="262" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step5-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;S3 events on collect bucket trigger Step Functions state machine to orchestrate ETL pipeline&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="262" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="310" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step6-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Collect-to-Cleanse Glue job applies schema mapping, transforms, and appends events to cleanse bucket (Parquet)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="310" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="358" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step7-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Cleanse-to-Consume Glue job deduplicates all cleanse data to produce current-state tables in consume bucket&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="358" width="548" height="38" as="geometry" />
        </mxCell>

        <mxCell id="legend-step8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;strokeWidth=2;shadow=1;glass=0;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="legend-panel">
          <mxGeometry x="20" y="406" width="40" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-step8-text" value="&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255))&quot;&gt;Athena provides SQL analytics on current-state claims, exposures, and payments data with Athena views for nested JSON&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="legend-panel">
          <mxGeometry x="72" y="406" width="548" height="38" as="geometry" />
