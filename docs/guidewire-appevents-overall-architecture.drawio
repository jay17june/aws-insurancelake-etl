              <mxPoint x="300" y="380" />
              <mxPoint x="660" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Step Functions to Glue Consume -->
        <mxCell id="edge-sf-to-glue2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16191F;strokeWidth=2;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="aws-cloud" source="step-functions" target="glue-consume">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="855" y="200" />
              <mxPoint x="480" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Glue Consume to S3 Consume -->
        <mxCell id="edge-glue2-to-consume" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16191F;strokeWidth=2;" edge="1" parent="aws-cloud" source="glue-consume" target="s3-consume">
          <mxGeometry relative="1" as="geometry">
