        <mxCell id="edge-glue1-to-cleanse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16191F;strokeWidth=2;" edge="1" parent="aws-cloud" source="glue-etl" target="s3-cleanse">
