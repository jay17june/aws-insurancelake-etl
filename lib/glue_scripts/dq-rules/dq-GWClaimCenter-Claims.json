{
    "after_transform": {
        "warn_rules": [
            "Completeness 'policynumber' > 0.90",
            "Completeness 'lobcode' > 0.90",
            "Completeness 'reporteddate' > 0.90",
            "Completeness 'insured_name' > 0.80",
            "ColumnValues 'claimstate' in [ 'open', 'closed', 'draft', 'archived' ]"
        ],
        "halt_rules": [
            "(ColumnExists 'claimnumber') and (IsComplete 'claimnumber')",
            "(ColumnExists 'lossdate') and (IsComplete 'lossdate')"
        ]
    }
}
