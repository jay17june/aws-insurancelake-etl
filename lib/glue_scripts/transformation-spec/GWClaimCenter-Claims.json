{
    "input_spec": {
        "table_description": "Guidewire ClaimCenter AppEvents - Claims",
        "strict_schema_mapping": false,
        "allow_schema_change": "evolve",
        "cleanse_partition_append": true,
        "json": {
            "multiline": false
        }
    },

    "transform_spec": {
        "date": [
            {
                "field": "lossdate",
                "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
            },
            {
                "field": "reporteddate",
                "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'"
            }
        ],

        "changetype": {
            "activities": "json",
            "contacts": "json",
            "exposures": "json",
            "reserves": "json",
            "policyaddresses": "json",
            "vehicle_incidents": "json",
            "notes": "json"
        },

        "combinecolumns": [
            {
                "field": "losslocation_full",
                "format": "{}, {}, {} {}",
                "source_columns": [
                    "losslocation_address1",
                    "losslocation_city",
                    "losslocation_statecode",
                    "losslocation_postalcode"
                ]
            }
        ],

        "literal": {
            "sourcesystem": "GWClaimCenter",
            "eventtype": "AppEvents"
        }
    }
}
